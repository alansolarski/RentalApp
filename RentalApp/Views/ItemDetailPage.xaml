<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentalApp.Views.ItemDetailPage"
             Title="{Binding Item.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"/>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage}"/>

            <Frame Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding Item.Title}"
                           FontSize="24"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding Item.Description}"
                           FontSize="16"
                           TextColor="Gray"/>

                    <BoxView HeightRequest="1"
                             Color="LightGray"/>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Daily Rate"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Item.DailyRate, StringFormat='£{0:F2}/day'}"
                                   TextColor="Green"
                                   FontSize="18"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Owner"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Item.Owner.FirstName}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="LightGray"/>

                    <Label Text="{Binding Item.IsAvailable, StringFormat='Available: {0}'}"
                           FontAttributes="Bold"
                           TextColor="Green"/>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Request Rental"
                    IsEnabled="{Binding Item.IsAvailable}"
                    BackgroundColor="Purple"
                    TextColor="White"/>

            <Button Text="Edit Item"
                    Command="{Binding NavigateToEditCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>