<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RentalApp.ViewModels"
             x:Class="RentalApp.Views.ProfilePage"
             Title="My Profile">

    <ScrollView>
        <VerticalStackLayout Spacing="16"
                             Padding="20">

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoadingProfile}"
                               IsVisible="{Binding IsLoadingProfile}"
                               HorizontalOptions="Center"/>

            <!-- Profile header -->
            <Frame Padding="20"
                   CornerRadius="12">
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">
                    <Label Text="{Binding UserProfile.FullName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CurrentUser.Email}"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding UserProfile.RatingDisplay}"
                           FontSize="20"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Stats -->
            <Frame Padding="16"
                   CornerRadius="12">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4">
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding UserProfile.ItemsListed}"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Items Listed"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding UserProfile.RentalsCompleted}"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="Rentals Completed"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Back button -->
            <Button Text="← Back"
                    Command="{Binding NavigateBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    HorizontalOptions="Start"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
